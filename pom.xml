    <properties>
        <warm-flow>${project.version}</warm-flow>

        <!-- 环境版本：JDK 17 基线，编译级别统一由根管理 -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.48</lombok.version>

        <!-- 生态版本 -->
        <springboot3.version>3.5.16</springboot3.version>
        <springboot4.version>4.0.8</springboot4.version>

        <!-- json库版本 -->
        <snack3.version>3.2.139</snack3.version>
        <snack4.version>4.0.59</snack4.version>
        <jackson.version>2.22.2</jackson.version>
        <jackson3.version>3.2.2</jackson3.version>
        <fastjson.version>2.0.65</fastjson.version>
        <gson.version>2.14.0</gson.version>

        <!-- orm库版本 -->
        <mybatis.version>3.5.19</mybatis.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <mybatis-spring-boot3.version>3.0.5</mybatis-spring-boot3.version>
        <mybatis-spring-boot4.version>4.0.1</mybatis-spring-boot4.version>

        <!-- 工具库版本 -->
        <slf4j-api.version>2.0.19</slf4j-api.version>
    </properties>

    <dependencyManagement>
